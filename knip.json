{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "src/scripts/*.ts"],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.ts"
  ],
  "rules": {
    "dependencies": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error"
  }
}
