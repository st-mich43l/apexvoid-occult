{
  "name": "void-occult",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "api:generate:openapi": "node scripts/run-generate-openapi.mjs",
    "api:generate:types": "openapi-typescript backend/openapi.json -o src/generated/api-schema.ts",
    "api:generate:fixtures": "tsx --tsconfig tsconfig.app.json src/scripts/generate-api-contract-fixtures.ts",
    "api:generate": "npm run api:generate:openapi && npm run api:generate:types",
    "api:check": "tsx --tsconfig tsconfig.app.json scripts/api-contract-check.ts",
    "audit:dead-code": "knip",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "release:monthly-flow-v1:gate": "tsx --tsconfig tsconfig.app.json src/scripts/monthly-flow-v1-gate.ts",
    "validate:palace-overview": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-release-gate.ts",
    "release:palace-overview:gate": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-release-gate.ts",
    "release:palace-overview:shadow": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-shadow-release.ts",
    "research:palace-overview:review-pack": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-review-pack.ts",
    "research:palace-overview:validate-reviews": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-validate-reviews.ts",
    "research:palace-overview:status": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-status.ts",
    "research:palace-overview:discover-cases": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-discover-cases.ts",
    "research:palace-overview:corpus-report": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-corpus-report.ts",
    "research:palace-overview:promote-cases": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-promote-cases.ts",
    "research:palace-overview:ingest-review": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-ingest-review.ts",
    "research:palace-overview:review-form": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-review-form.ts",
    "research:palace-overview:compare-candidate": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-compare-candidate.ts",
    "research:palace-overview:derive-bands": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-derive-bands.ts",
    "research:palace-overview:compare-four-axis": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-compare-four-axis.ts",
    "research:annual-axes-v10:validate": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v10-research.ts validate",
    "research:annual-axes-v10:compare": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v10-research.ts compare",
    "research:annual-axes-v10:audit": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v10-research.ts audit",
    "research:annual-axes-v10:romance-case": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v10-research.ts romance-case",
    "research:annual-axes-v10:romance-audit": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v10-research.ts romance-audit",
    "research:annual-axes-v011:validate": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v011-research.ts validate",
    "research:annual-axes-v011:case": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v011-research.ts case",
    "research:annual-axes-v011:audit": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v011-research.ts audit",
    "research:annual-axes-v012:validate": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts validate",
    "research:annual-axes-v012:case": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts case",
