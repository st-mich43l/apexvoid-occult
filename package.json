    "research:annual-axes-v012:layers": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts layers",
    "research:annual-axes-v012:sensitivity": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts sensitivity",
    "research:annual-axes-v012:ablation": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts ablation",
    "research:annual-axes-v012:audit": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v012-research.ts audit",
    "research:annual-axes-v013:validate": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v013-research.ts validate",
    "research:annual-axes-v013:case": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v013-research.ts case",
    "research:annual-axes-v013:audit": "tsx --tsconfig tsconfig.app.json src/scripts/annual-axes-v013-research.ts audit"
