{
  "name": "void-occult",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "audit:dead-code": "knip",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "release:monthly-flow-v1:gate": "tsx --tsconfig tsconfig.app.json src/scripts/monthly-flow-v1-gate.ts",
    "validate:palace-overview": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-release-gate.ts",
    "release:palace-overview:gate": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-release-gate.ts",
    "release:palace-overview:shadow": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-shadow-release.ts",
    "research:palace-overview:review-pack": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-review-pack.ts",
    "research:palace-overview:validate-reviews": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-validate-reviews.ts",
    "research:palace-overview:status": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-status.ts",
    "research:palace-overview:discover-cases": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-discover-cases.ts",
    "research:palace-overview:corpus-report": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-corpus-report.ts",
    "research:palace-overview:promote-cases": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-promote-cases.ts",
    "research:palace-overview:ingest-review": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-ingest-review.ts",
    "research:palace-overview:review-form": "tsx --tsconfig tsconfig.app.json src/scripts/palace-overview-review-form.ts"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "knip": "^6.29.0",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
