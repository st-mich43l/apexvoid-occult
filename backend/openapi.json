        "type": "object"
      },
      "TemporalSnapshotBundle": {
        "description": "Foreign-year ChartDTO snapshots generated by TypeScript Calculation Core.\n\nAnchor chart is NOT duplicated here. Max 5 snapshots; at least 1 when present.",
        "properties": {
          "anchorAnnualYear": {
            "title": "Anchorannualyear",
            "type": "integer"
          },
          "snapshots": {
            "items": {
              "$ref": "#/components/schemas/ChartDTO"
