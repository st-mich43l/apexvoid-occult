        "description": "Identity / set / anchor mismatch after a snapshot retry.",
        "properties": {
          "code": {
            "enum": [
              "TEMPORAL_SNAPSHOT_IDENTITY_MISMATCH",
              "TEMPORAL_ANCHOR_MISMATCH",
              "TEMPORAL_SNAPSHOT_SET_MISMATCH"
