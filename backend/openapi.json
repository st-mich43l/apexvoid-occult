  "info": {
    "title": "Void Occult — Tử Vi luận giải",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/interpret": {
      "post": {
        "operationId": "interpret_api_interpret_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterpretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemporalSnapshotsRequiredResponse"
                }
              }
            },
            "description": "Foreign-year snapshots required (zero side effects)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedNarrativeSchoolResponse"
                }
              }
            },
            "description": "Unsupported narrative school, temporal range/year errors, or snapshot validation failures (see api_errors models in OpenAPI)"
          }
        },
        "summary": "Interpret"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
